{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform-studio.local/schemas/naming/intent.schema.json",
  "title": "Offline naming request; not deployment input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "intent",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namingProfile",
        "stackDisplayName",
        "stackAcronym",
        "instanceId",
        "instanceOrdinal",
        "environment",
        "exposure",
        "region",
        "subscriptionId",
        "namespaceSalt"
      ],
      "properties": {
        "namingProfile": {
          "const": "standard-v2"
        },
        "stackDisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "stackAcronym": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,3}$"
        },
        "instanceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "instanceOrdinal": {
          "type": "string",
          "pattern": "^(0[1-9]|[1-9][0-9])$"
        },
        "environment": {
          "enum": [
            "dev",
            "qa",
            "uat",
            "prod"
          ]
        },
        "exposure": {
          "enum": [
            "internal",
            "external"
          ]
        },
        "region": {
          "const": "eastus2"
        },
        "subscriptionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "namespaceSalt": {
          "type": "string",
          "pattern": "^[a-z0-9]{0,16}$"
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "armType",
          "mode",
          "condition"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,79}$"
          },
          "armType": {
            "enum": [
              "Microsoft.Resources/resourceGroups",
              "Microsoft.Resources/deploymentStacks",
              "Microsoft.Network/virtualNetworks",
              "Microsoft.Network/networkSecurityGroups",
              "Microsoft.Network/privateEndpoints",
              "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
              "Microsoft.OperationalInsights/workspaces",
              "Microsoft.Insights/components",
              "Microsoft.Insights/metricAlerts",
              "Microsoft.Insights/scheduledQueryRules",
              "Microsoft.Web/serverfarms",
              "Microsoft.Web/sites",
              "Microsoft.ManagedIdentity/userAssignedIdentities",
              "Microsoft.Databricks/accessConnectors",
              "Microsoft.Databricks/workspaces",
              "Microsoft.DataFactory/factories",
              "Microsoft.EventGrid/topics",
              "Microsoft.KeyVault/vaults",
              "Microsoft.ServiceBus/namespaces",
              "Microsoft.Storage/storageAccounts",
              "Microsoft.ContainerService/managedClusters",
              "Microsoft.Network/virtualNetworks/subnets",
              "Microsoft.Authorization/roleAssignments",
              "Microsoft.Insights/workbooks",
              "Microsoft.Network/privateDnsZones",
              "Microsoft.Storage/storageAccounts/blobServices",
              "Microsoft.Storage/storageAccounts/fileServices",
              "Microsoft.Storage/storageAccounts/queueServices",
              "Microsoft.Storage/storageAccounts/tableServices",
              "Microsoft.ServiceBus/namespaces/networkRuleSets",
              "Microsoft.Web/sites/config",
              "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
              "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
              "Microsoft.ManagedIdentity/userAssignedIdentities/federatedIdentityCredentials",
              "Microsoft.DataFactory/factories/datasets",
              "Microsoft.DataFactory/factories/integrationRuntimes",
              "Microsoft.DataFactory/factories/linkedservices",
              "Microsoft.DataFactory/factories/managedVirtualNetworks",
              "Microsoft.DataFactory/factories/managedVirtualNetworks/managedPrivateEndpoints",
              "Microsoft.DataFactory/factories/pipelines",
              "Microsoft.EventGrid/topics/eventSubscriptions",
              "Microsoft.Insights/diagnosticSettings",
              "Microsoft.ServiceBus/namespaces/queues",
              "Microsoft.Storage/storageAccounts/blobServices/containers",
              "Microsoft.Storage/storageAccounts/fileServices/shares",
              "Microsoft.Storage/storageAccounts/queueServices/queues",
              "Microsoft.Network/networkManagers",
              "Microsoft.Network/networkManagers/ipamPools",
              "Microsoft.Network/networkManagers/ipamPools/staticCidrs",
              "Microsoft.ContainerService/managedClusters/agentPools",
              "Microsoft.Network/networkSecurityGroups/securityRules"
            ]
          },
          "mode": {
            "enum": [
              "convention",
              "fixed",
              "reference",
              "providerAssigned",
              "unresolved"
            ]
          },
          "condition": {
            "enum": [
              "included",
              "excluded",
              "unknown"
            ]
          },
          "role": {
            "type": "string"
          },
          "parentKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,79}$"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "explicitName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260
          },
          "existingResourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
