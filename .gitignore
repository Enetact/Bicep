# Build outputs, generated reports and distributable packages (not source).
**/bin/
**/obj/
artifacts/
*.zip

# Local runtime, Codex homes, portable tools and emulator data.
# Agent source remains in src/; .local/portal/agents contains runtime copies only.
# .local/portal/azure-cli contains isolated local-auth credentials; never publish it.
.local/
.tools/
.azure/
**/node_modules/

# Machine-specific settings and credentials. Keep sanitized setup examples.
local.settings.json
**/local.settings.*.json
!**/local.settings.example.json
!**/local.settings.azurite.example.json
.env
.env.*
!.env.example
**/portal.local.json
**/auth.json
# GitHub CLI credential file if a developer uses a repository-local GH_CONFIG_DIR.
**/hosts.yml
**/accessTokens.json
**/azureProfile.json
**/service_principal_entries.json
**/msal_token_cache*
**/msal_http_cache*
*.pfx
*.p12
*.key

# If a developer points Codex at a repository-local home, exclude its state.
# Do not ignore .codex/ itself: project instructions, skills and config are source.
.codex/sessions/
.codex/log/
.codex/logs/
.codex/tmp/
.codex/shell_snapshots/
.codex/history.jsonl
.codex/models_cache.json
.codex/session_index.jsonl
.codex/*.sqlite*

# Test evidence and local editor state. Test source/fixtures remain versioned.
**/TestResults/
test-results/
playwright-report/
coverage/
*.trx
*.coverage
*.coveragexml
*.log
.vs/
.idea/
*.user
*.suo

# Databricks/ADF scripts, notebooks and bundle templates are source: keep them.
# Ignore only deployment state, credentials, Python environments and caches.
**/.databricks/
**/__pycache__/
**/.venv/
**/.pytest_cache/
**/.ruff_cache/
**/.ipynb_checkpoints/
*.py[cod]
**/.databrickscfg

# Developer Kubernetes/Helm credentials and caches. Reviewed charts remain source.
**/.kube/
**/.helm/
kubeconfig.local*
helm-registry.local.json
