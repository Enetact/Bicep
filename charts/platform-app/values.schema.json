{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "imageRepository",
    "imageDigest",
    "workloadIdentityClientId",
    "serviceAccountName",
    "replicas",
    "port",
    "cpuRequest",
    "cpuLimit",
    "memoryRequest",
    "memoryLimit",
    "egressCidrs"
  ],
  "properties": {
    "imageRepository": {
      "type": "string",
      "pattern": "^[a-z0-9]+\\.azurecr\\.io/[a-z0-9][a-z0-9/_-]{0,100}$"
    },
    "imageDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "workloadIdentityClientId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"
    },
    "serviceAccountName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,39}$"
    },
    "replicas": {
      "type": "integer",
      "minimum": 3,
      "maximum": 6
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "cpuRequest": {
      "enum": [
        "100m",
        "250m",
        "500m"
      ]
    },
    "cpuLimit": {
      "enum": [
        "1000m",
        "2000m"
      ]
    },
    "memoryRequest": {
      "enum": [
        "128Mi",
        "256Mi"
      ]
    },
    "memoryLimit": {
      "enum": [
        "512Mi",
        "1Gi"
      ]
    },
    "egressCidrs": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([89]|[12][0-9]|3[0-2])$"
      }
    }
  }
}
