{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "Poll": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Second",
          "interval": 30
        },
        "runtimeConfiguration": {
          "concurrency": {
            "runs": 1
          }
        }
      }
    },
    "actions": {
      "Get_messages": {
        "type": "Http",
        "inputs": {
          "method": "GET",
          "uri": "@concat('https://',appsetting('EVENT_STORAGE_NAME'),'.queue.core.windows.net/events/messages?numofmessages=8&visibilitytimeout=300')",
          "authentication": {
            "type": "ManagedServiceIdentity",
            "audience": "https://storage.azure.com/"
          },
          "headers": {
            "x-ms-version": "2023-11-03",
            "x-ms-date": "@formatDateTime(utcNow(),'R')"
          },
          "retryPolicy": {
            "type": "fixed",
            "count": 3,
            "interval": "PT5S"
          }
        },
        "runtimeConfiguration": {
          "secureData": {
            "properties": [
              "inputs",
              "outputs"
            ]
          }
        },
        "runAfter": {}
      },
      "For_each_message": {
        "type": "Foreach",
        "foreach": "@xpath(xml(body('Get_messages')),'/QueueMessagesList/QueueMessage')",
        "runtimeConfiguration": {
          "concurrency": {
            "repetitions": 1
          }
        },
        "runAfter": {
          "Get_messages": [
            "Succeeded"
          ]
        },
        "actions": {
          "Queue_message": {
            "type": "Compose",
            "inputs": "@json(xml(items('For_each_message')))?['QueueMessage']",
            "runAfter": {}
          },
          "Process": {
            "type": "Scope",
            "actions": {
              "Decode_base64": {
                "type": "Compose",
                "inputs": "@json(base64ToString(string(outputs('Queue_message')?['MessageText'])))",
                "runAfter": {}
              },
              "Decode_plain": {
                "type": "Compose",
                "inputs": "@json(string(outputs('Queue_message')?['MessageText']))",
                "runAfter": {
                  "Decode_base64": [
                    "Failed"
                  ]
                }
              },
              "Event": {
                "type": "Compose",
                "inputs": "@coalesce(actions('Decode_base64')?['outputs'],actions('Decode_plain')?['outputs'])",
                "runAfter": {
                  "Decode_plain": [
                    "Succeeded",
                    "Skipped"
                  ]
                }
              },
              "Validate_schema": {
                "type": "ParseJson",
                "inputs": {
                  "content": "@outputs('Event')",
                  "schema": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "topic",
                      "subject",
                      "eventType",
                      "eventTime",
                      "data",
                      "dataVersion",
                      "metadataVersion"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                      },
                      "topic": {
                        "type": "string"
                      },
                      "subject": {
                        "type": "string",
                        "maxLength": 256
                      },
                      "eventType": {
                        "type": "string",
                        "enum": [
                          "Document.Received"
                        ]
                      },
                      "eventTime": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "dataVersion": {
                        "type": "string",
                        "enum": [
                          "1"
                        ]
                      },
                      "metadataVersion": {
                        "type": "string",
                        "enum": [
                          "1"
                        ]
                      },
                      "data": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "documentId",
                          "correlationId"
                        ],
                        "properties": {
                          "documentId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "correlationId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          }
                        }
                      }
                    }
                  }
                },
                "runAfter": {
                  "Event": [
                    "Succeeded"
                  ]
                }
              },
              "Validate_scope": {
                "type": "If",
                "expression": "@and(equals(toLower(body('Validate_schema')?['topic']),toLower(appsetting('EXPECTED_TOPIC'))),startsWith(body('Validate_schema')?['subject'],'/documents/'),lessOrEquals(length(base64(string(outputs('Event')))),21844))",
                "actions": {},
                "else": {
                  "actions": {
                    "Reject_scope": {
                      "type": "ParseJson",
                      "inputs": {
                        "content": {},
                        "schema": {
                          "type": "object",
                          "required": [
                            "scopeMustMatch"
                          ]
                        }
                      }
                    }
                  }
                },
                "runAfter": {
                  "Validate_schema": [
                    "Succeeded"
                  ]
                }
              },
              "Receipt": {
                "type": "Compose",
                "inputs": {
                  "eventId": "@toLower(body('Validate_schema')?['id'])",
                  "topic": "@toLower(body('Validate_schema')?['topic'])",
                  "subject": "@body('Validate_schema')?['subject']",
                  "documentId": "@body('Validate_schema')?['data']?['documentId']",
                  "correlationId": "@body('Validate_schema')?['data']?['correlationId']",
                  "dataVersion": "1"
                },
                "runAfter": {
                  "Validate_scope": [
                    "Succeeded"
                  ]
                }
              },
              "Create_receipt": {
                "type": "Http",
                "inputs": {
                  "method": "PUT",
                  "uri": "@concat('https://',appsetting('EVENT_STORAGE_NAME'),'.blob.core.windows.net/receipts/',concat(toLower(body('Validate_schema')?['id']),'.json'))",
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "audience": "https://storage.azure.com/"
                  },
                  "headers": {
                    "x-ms-version": "2023-11-03",
                    "If-None-Match": "*",
                    "x-ms-blob-type": "BlockBlob",
                    "Content-Type": "application/json",
                    "x-ms-date": "@formatDateTime(utcNow(),'R')"
                  },
                  "retryPolicy": {
                    "type": "fixed",
                    "count": 3,
                    "interval": "PT5S"
                  },
                  "body": "@outputs('Receipt')"
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                },
                "runAfter": {
                  "Receipt": [
                    "Succeeded"
                  ]
                }
              },
              "Existing_receipt": {
                "type": "If",
                "expression": "@equals(actions('Create_receipt')?['outputs']?['statusCode'],412)",
                "actions": {
                  "Read_receipt": {
                    "type": "Http",
                    "inputs": {
                      "method": "GET",
                      "uri": "@concat('https://',appsetting('EVENT_STORAGE_NAME'),'.blob.core.windows.net/receipts/',concat(toLower(body('Validate_schema')?['id']),'.json'))",
                      "authentication": {
                        "type": "ManagedServiceIdentity",
                        "audience": "https://storage.azure.com/"
                      },
                      "headers": {
                        "x-ms-version": "2023-11-03",
                        "x-ms-date": "@formatDateTime(utcNow(),'R')"
                      },
                      "retryPolicy": {
                        "type": "fixed",
                        "count": 3,
                        "interval": "PT5S"
                      }
                    },
                    "runtimeConfiguration": {
                      "secureData": {
                        "properties": [
                          "inputs",
                          "outputs"
                        ]
                      }
                    },
                    "runAfter": {}
                  },
                  "Compare_receipt": {
                    "type": "If",
                    "expression": "@equals(body('Read_receipt'),outputs('Receipt'))",
                    "actions": {},
                    "else": {
                      "actions": {
                        "Reject_conflict": {
                          "type": "ParseJson",
                          "inputs": {
                            "content": {},
                            "schema": {
                              "type": "object",
                              "required": [
                                "receiptMustMatch"
                              ]
                            }
                          }
                        }
                      }
                    },
                    "runAfter": {
                      "Read_receipt": [
                        "Succeeded"
                      ]
                    }
                  }
                },
                "else": {
                  "actions": {
                    "Retry_write_failure": {
                      "type": "ParseJson",
                      "inputs": {
                        "content": {},
                        "schema": {
                          "type": "object",
                          "required": [
                            "writeMustSucceed"
                          ]
                        }
                      }
                    }
                  }
                },
                "runAfter": {
                  "Create_receipt": [
                    "Failed"
                  ]
                }
              },
              "Durable_result": {
                "type": "If",
                "expression": "@or(equals(actions('Create_receipt')?['status'],'Succeeded'),and(equals(actions('Existing_receipt')?['status'],'Succeeded'),equals(actions('Create_receipt')?['outputs']?['statusCode'],412)))",
                "actions": {
                  "Delete_message": {
                    "type": "Http",
                    "inputs": {
                      "method": "DELETE",
                      "uri": "@concat('https://',appsetting('EVENT_STORAGE_NAME'),'.queue.core.windows.net/events/messages/',encodeUriComponent(outputs('Queue_message')?['MessageId']),'?popreceipt=',encodeUriComponent(outputs('Queue_message')?['PopReceipt']))",
                      "authentication": {
                        "type": "ManagedServiceIdentity",
                        "audience": "https://storage.azure.com/"
                      },
                      "headers": {
                        "x-ms-version": "2023-11-03",
                        "x-ms-date": "@formatDateTime(utcNow(),'R')"
                      },
                      "retryPolicy": {
                        "type": "fixed",
                        "count": 3,
                        "interval": "PT5S"
                      }
                    },
                    "runtimeConfiguration": {
                      "secureData": {
                        "properties": [
                          "inputs",
                          "outputs"
                        ]
                      }
                    },
                    "runAfter": {}
                  }
                },
                "else": {
                  "actions": {
                    "Not_durable": {
                      "type": "ParseJson",
                      "inputs": {
                        "content": {},
                        "schema": {
                          "type": "object",
                          "required": [
                            "durableResultRequired"
                          ]
                        }
                      }
                    }
                  }
                },
                "runAfter": {
                  "Existing_receipt": [
                    "Succeeded",
                    "Skipped"
                  ],
                  "Create_receipt": [
                    "Succeeded",
                    "Failed"
                  ]
                }
              }
            },
            "runAfter": {
              "Queue_message": [
                "Succeeded"
              ]
            }
          },
          "Failed_message": {
            "type": "If",
            "expression": "@greaterOrEquals(int(coalesce(outputs('Queue_message')?['DequeueCount'],'0')),5)",
            "actions": {
              "Quarantine": {
                "type": "Http",
                "inputs": {
                  "method": "PUT",
                  "uri": "@concat('https://',appsetting('EVENT_STORAGE_NAME'),'.blob.core.windows.net/quarantine/',encodeUriComponent(outputs('Queue_message')?['MessageId']))",
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "audience": "https://storage.azure.com/"
                  },
                  "headers": {
                    "x-ms-version": "2023-11-03",
                    "x-ms-blob-type": "BlockBlob",
                    "Content-Type": "application/json",
                    "x-ms-date": "@formatDateTime(utcNow(),'R')"
                  },
                  "retryPolicy": {
                    "type": "fixed",
                    "count": 3,
                    "interval": "PT5S"
                  },
                  "body": {
                    "messageId": "@outputs('Queue_message')?['MessageId']",
                    "encodedMessage": "@outputs('Queue_message')?['MessageText']",
                    "reason": "Invalid, conflicting or retry-exhausted event"
                  }
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                },
                "runAfter": {}
              },
              "Delete_quarantined": {
                "type": "Http",
                "inputs": {
                  "method": "DELETE",
                  "uri": "@concat('https://',appsetting('EVENT_STORAGE_NAME'),'.queue.core.windows.net/events/messages/',encodeUriComponent(outputs('Queue_message')?['MessageId']),'?popreceipt=',encodeUriComponent(outputs('Queue_message')?['PopReceipt']))",
                  "authentication": {
                    "type": "ManagedServiceIdentity",
                    "audience": "https://storage.azure.com/"
                  },
                  "headers": {
                    "x-ms-version": "2023-11-03",
                    "x-ms-date": "@formatDateTime(utcNow(),'R')"
                  },
                  "retryPolicy": {
                    "type": "fixed",
                    "count": 3,
                    "interval": "PT5S"
                  }
                },
                "runtimeConfiguration": {
                  "secureData": {
                    "properties": [
                      "inputs",
                      "outputs"
                    ]
                  }
                },
                "runAfter": {
                  "Quarantine": [
                    "Succeeded"
                  ]
                }
              }
            },
            "else": {
              "actions": {}
            },
            "runAfter": {
              "Process": [
                "Failed",
                "TimedOut"
              ]
            }
          }
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
