{
  "IsEncrypted": false,
  "Values": {
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "AZURE_FUNCTIONS_ENVIRONMENT": "Development",
    "LocalDevelopment__Enabled": "true",
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "UploadStorage": "UseDevelopmentStorage=true",
    "TransferQueueStorage": "UseDevelopmentStorage=true",
    "UploadContainer": "incoming",
    "Ledger__container": "transfer-ledger",
    "Destination__container": "local-destination",
    "TransferQueue": "transfer-work",
    "Copy__scopePrefixes": "{\"\":\"default\"}",
    "Copy__maxBytes": "1073741824",
    "Recovery__includeSourceVersions": "false",
    "RecoverySchedule": "*/15 * * * * *",
    "PoisonMonitorSchedule": "*/15 * * * * *",
    "AzureFunctionsJobHost__logging__logLevel__default": "Information"
  },
  "Host": { "LocalHttpPort": 7071 }
}
