<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <RuntimeFrameworkVersion Condition="'$(SelfContained)' == 'true'">10.0.12</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.Identity.Client" Version="4.90.1" /></ItemGroup>
  <ItemGroup><Content Update="portal.local.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" /></ItemGroup>
</Project>
