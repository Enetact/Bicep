{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workloadName",
    "environment",
    "region",
    "workloadType"
  ],
  "properties": {
    "workloadName": {
      "const": "observe"
    },
    "environment": {
      "enum": [
        "dev",
        "qa",
        "uat",
        "prod"
      ]
    },
    "region": {
      "enum": [
        "eastus2"
      ]
    },
    "workloadType": {
      "const": "observability"
    }
  }
}
