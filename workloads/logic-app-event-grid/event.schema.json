{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "topic",
    "subject",
    "eventType",
    "eventTime",
    "data",
    "dataVersion",
    "metadataVersion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "topic": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "maxLength": 256
    },
    "eventType": {
      "type": "string",
      "enum": [
        "Document.Received"
      ]
    },
    "eventTime": {
      "type": "string",
      "format": "date-time"
    },
    "dataVersion": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "metadataVersion": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "correlationId"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    }
  }
}
